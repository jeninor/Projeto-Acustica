=== Stage-2 Pyroomacoustics multiband directivity benchmark ===
environment: local-docker
python: 3.11.16
pyroomacoustics: 0.10.1
numpy: 2.4.6
platform: Linux-6.12.76-linuxkit-x86_64-with-glibc2.41
cpu: Intel(R) Core(TM) i7-6700 CPU @ 3.40GHz
cpu_count_os: 8
cpu_affinity_count: 8
pra_num_threads: 1
omp_num_threads: 1
openblas_num_threads: 1
mkl_num_threads: 1

=== Fixed benchmark configuration ===
room_dim_m: [6.0, 5.0, 3.0]
source_pos_m: [2.0, 2.5, 1.5]
n_mics: 25
fs_hz: 16000
max_order: 10
absorption_per_band: 0.35
band_centers_hz: [125.0, 250.0, 500.0, 1000.0, 2000.0, 4000.0, 8000.0]
source_orientation_deg: {'azimuth': 0.0, 'colatitude': 90.0, 'roll': 0.0}
CF2: /app/speaker.cf2
CF2 handedness: top_to_left
CF2 interpolation_domain: db
warmup_rounds: 3
repetitions_per_case: 20

=== Building CF2 adapter once (excluded from compute_rir timing) ===
cf2_build_elapsed_s: 0.0015087319999995685
valid_cf2_frequencies_hz: [100.0, 125.0, 160.0, 200.0, 250.0, 315.0, 400.0, 500.0, 630.0, 800.0, 1000.0, 1250.0, 1600.0, 2000.0, 2500.0, 3150.0, 4000.0, 5000.0, 6300.0, 8000.0, 10000.0]
preflight_room_is_multi_band: True
preflight_wall_absorption_shape: (7,)
preflight_cf2_type: <class 'cf2_pra_directivity.CF2SevenBandDirectivity'>

